    "clsx": "^2.1.1",
    "konva": "^10.5.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hotkeys-hook": "^5.3.3",
    "react-konva": "^19.2.7",
